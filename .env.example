# Copie para .env.local e preencha. Nunca commite valores reais.

# --- Banco (Railway) ---
# Aponte para o PgBouncer, nao direto para o Postgres: a Vercel e serverless e
# abre conexao por requisicao. Sem pooler, o limite de conexoes estoura sob carga.
DATABASE_URL="postgresql://usuario:senha@host:6543/railway"

# Conexao direta com o Postgres (porta 5432), sem pooler.
# Usada so por migrations do Drizzle — DDL nao funciona em pooler transaction mode.
DIRECT_DATABASE_URL="postgresql://usuario:senha@host:5432/railway"

# --- Auth.js ---
# Gere com: npx auth secret
AUTH_SECRET=""
# Em producao a Vercel injeta a URL sozinha; local precisa disso:
AUTH_URL="http://localhost:3000"

# --- Arquivos (foto de comprovante de entrega) ---
BLOB_READ_WRITE_TOKEN=""
